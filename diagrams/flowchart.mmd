%% AirSleuth Flowchart：Input → Processing → AI/Analytics → Decision → Output
%% 含判斷（菱形）、迴圈、例外處理與人機互動
flowchart TD
    S([開始：使用者提問]) --> I1["② 解析提問<br/>地點、時間、族群、活動"]
    I1 --> C1{地點與時間<br/>明確嗎？}
    C1 -- 否 --> H1["⑧ 追問使用者<br/>（人機互動）"] --> I1
    C1 -- 是 --> P1["③ 規劃：決定要查哪些資料、半徑多大"]

    P1 --> D1["④ 取得資料<br/>微型感測器、測站、氣象"]
    D1 --> C2{API 成功？}
    C2 -- 否 --> E1["例外處理：改用本地資料庫的最近資料<br/>並標記「資料可能過時」"]
    E1 --> C3
    C2 -- 是 --> Q1["資料品質檢查"]
    Q1 --> C3{可用感測器<br/>≥ 最低數量？}
    C3 -- 否，且已擴大過 2 次 --> E2["例外處理：改用最近的國家測站<br/>信心降為「低」"]
    C3 -- 否 --> X1["擴大搜尋半徑或時間窗"] --> D1
    C3 -- 是 --> A1["⑤ 可信度評估與濕度校正"]
    E2 --> A3

    A1 --> A2["⑤ 計算區域背景、局部超量、空間一致性"]
    A2 --> A3["⑤ 短期趨勢預測"]
    A3 --> A4{"⑤ 來源判斷"}
    A4 -- 一致性高、局部超量小 --> T1["區域型：整個區域一起升高"]
    A4 -- 局部超量大、一致性低 --> T2{鄰近感測器<br/>也升高嗎？}
    T2 -- 是 --> T3["局部型：附近有污染源"]
    T2 -- 否，只有單一感測器 --> T4["疑似感測器異常<br/>降低信心"]
    A4 -- 8 km 內一起升高、外環沒有 --> T7["次區域型：約 8 km 的群聚"]
    A4 -- 兩者都高 --> T5["混合型"]
    A4 -- 兩者都低 --> T6["背景正常、沒有明顯事件"]

    T1 & T7 & T3 & T4 & T5 & T6 --> K1["⑥ 檢索領域知識<br/>AQI 門檻、族群建議、運動取捨"]
    K1 --> R1["⑦ 估算使用者的暴露與風險"]
    R1 --> C4{敏感族群？}
    C4 -- 是 --> R2["使用較嚴格的門檻"] --> R3
    C4 -- 否 --> R3["⑦ 產生候選行動並排序"]
    R3 --> C5{信心程度<br/>足夠嗎？}
    C5 -- 否 --> R4["明確說明不確定性<br/>並提供保守建議"] --> O1
    C5 -- 是 --> O1["⑧ 輸出：結論、原因與證據、建議、信心、資料來源"]
    O1 --> C6{使用者追問<br/>或回饋？}
    C6 -- 是 --> I1
    C6 -- 否 --> Z([結束])
